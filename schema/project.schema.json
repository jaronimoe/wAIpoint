{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "required": ["name", "status", "created"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "repos": {
      "type": "array",
      "items": { "type": "string" },
      "description": "GitHub repos in owner/repo format"
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "completed", "archived"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created": { "type": "string", "format": "date-time" },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last write through the CLI"
    },
    "edited": {
      "type": "string",
      "format": "date-time",
      "description": "Last write through the dashboard"
    }
  }
}
