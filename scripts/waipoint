#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/waipoint/config"
TRACKER_REPO=""
MARKER_FILE="waipoint-data.json"
DEFAULT_DATA_REPO="waipoint-data"
ASSUME_YES=false

usage() {
  cat <<'EOF'
Usage: waipoint <command> [options]

Setup:
  init                                Create or connect your data repo
    --repo <[owner/]name>             Data repo (default: the configured repo,
                                      else <your-login>/waipoint-data)
    --yes                             Create or mark the repo without asking

Project commands:
  init-project <slug>                 Create a new project
    --name <name>                     Human-readable name (default: slug)
    --repo <owner/repo>               GitHub repo (repeatable)
    --description <desc>              Project description
    --tags <t1,t2,...>                Comma-separated tags

  update-project <slug>               Update project metadata
    --status <status>                 active|paused|completed|archived
    --description <desc>              Update description

Work package commands:
  init-wp <project> <wp-slug>         Create a work package
    --name <name>                     Human-readable name (default: slug)
    --description <desc>              Description
    --priority <low|medium|high>      Priority level

  update-wp <project> <wp-slug>       Update work package
    --status <status>                 planned|in-progress|blocked|done
    --priority <low|medium|high>      Priority level

Task commands:
  add-task <project> <wp> <task-slug> Add a task
    --name <name>                     Task name (default: slug)

  update-task <project> <wp> <task>   Update a task
    --status <status>                 open|current|done|dropped
    --commit <url>                    Append a commit URL
    --notes <text>                    Set notes

Read commands:
  list                                List all projects
  show <project>                      Show project with work packages and tasks
  dashboard [file]                    Generate HTML dashboard (default: dashboard.html)
    --open                            Open in browser after generating
    --force                           Rebuild even if no changes detected

Configuration:
  The tracker repo (owner/name) comes from WAIPOINT_REPO, or else from a
  repo= line in ~/.config/waipoint/config, which `waipoint init` writes.
  There is no default.
EOF
  exit 1
}

now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

valid_repo() { [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; }

# The repo= line from the config file, or nothing.
config_repo() {
  [ -f "$CONFIG_FILE" ] || return 0
  sed -n 's/^[[:space:]]*repo[[:space:]]*=[[:space:]]*//p' "$CONFIG_FILE" | tail -n 1 | tr -d '[:space:]'
}

# No default on purpose: a default that names the wrong repo does not fail, it
# reads and writes somewhere else.
resolve_tracker_repo() {
  TRACKER_REPO="${WAIPOINT_REPO:-}"
  if [ -z "$TRACKER_REPO" ]; then
    TRACKER_REPO=$(config_repo)
  fi
  if [ -z "$TRACKER_REPO" ]; then
    echo "Error: no tracker repo configured. Run 'waipoint init' to create or connect one,"
    echo "or set WAIPOINT_REPO=<owner>/<data-repo>."
    exit 1
  fi
  if ! valid_repo "$TRACKER_REPO"; then
    echo "Error: tracker repo '${TRACKER_REPO}' is not in owner/name form"
    exit 1
  fi
}

gh_get_file() {
  local out
  out=$(gh api "repos/${TRACKER_REPO}/contents/${1}" --jq '.content' 2>/dev/null) || { echo ""; return; }
  printf '%s' "$out" | base64 -d 2>/dev/null
}

gh_get_sha() {
  local out
  out=$(gh api "repos/${TRACKER_REPO}/contents/${1}" --jq '.sha' 2>/dev/null) || { echo ""; return; }
  printf '%s\n' "$out"
}

# Blob sha on the first line, base64 content after it -- from ONE read. Two
# separate reads can pair a newer sha with older content, and the PUT would
# then overwrite whatever was written in between.
gh_get_sha_and_file() {
  local out
  out=$(gh api "repos/${TRACKER_REPO}/contents/${1}" --jq '.sha + "\n" + .content' 2>/dev/null) || { echo ""; return; }
  printf '%s\n' "$out"
}

# Entry names in a directory of the tracker repo, one per line, or nothing when
# it does not exist. On an HTTP error gh still prints the error body to stdout,
# so a failed call must drop its output rather than append a fallback to it.
gh_list_dir() {
  local out
  out=$(gh api "repos/${TRACKER_REPO}/contents/${1}" --jq '.[].name' 2>/dev/null) || return 0
  printf '%s\n' "$out"
}

# Look for the marker in TRACKER_REPO. Returns 0 when it is there, 1 when it is
# not (404), and 2 when the check itself failed, with gh's error in MARKER_ERR.
MARKER_ERR=""
check_marker() {
  if MARKER_ERR=$(gh api "repos/${TRACKER_REPO}/contents/${MARKER_FILE}" --silent 2>&1); then
    return 0
  fi
  [[ "$MARKER_ERR" == *"HTTP 404"* ]] && return 1
  return 2
}

# Every write goes through gh_put_file, so this is the one place that stops a
# write to a repo that is not a wAIpoint data repo. A repo name can be valid
# and still wrong -- a typo, or an old name now owned by another repo -- and a
# PUT without a sha would quietly create files there.
require_data_repo() {
  local marker=0
  check_marker || marker=$?
  [ "$marker" -eq 0 ] && return
  if [ "$marker" -eq 1 ]; then
    echo "Error: ${TRACKER_REPO} has no ${MARKER_FILE} at its root (or your gh login cannot read it), so it is not a wAIpoint data repo. Nothing was written."
    echo "Check WAIPOINT_REPO or ${CONFIG_FILE}."
  else
    echo "Error: could not check ${TRACKER_REPO} for ${MARKER_FILE}. Nothing was written."
    echo "$MARKER_ERR"
  fi
  exit 1
}

gh_put_file() {
  local path="$1" content="$2" message="$3" sha="${4:-}"
  require_data_repo
  local encoded
  encoded=$(printf '%s' "$content" | base64)
  local body
  if [ -n "$sha" ]; then
    body=$(jq -n --arg msg "$message" --arg c "$encoded" --arg sha "$sha" \
      '{message:$msg, content:$c, sha:$sha}')
  else
    body=$(jq -n --arg msg "$message" --arg c "$encoded" \
      '{message:$msg, content:$c}')
  fi
  gh api "repos/${TRACKER_REPO}/contents/${path}" --method PUT --input - <<< "$body" > /dev/null
}

gh_update_json() {
  local path="$1" message="$2"
  shift 2
  local raw current sha updated
  raw=$(gh_get_sha_and_file "$path")
  [ -z "$raw" ] && { echo "Error: ${path} not found"; exit 1; }
  sha=${raw%%$'\n'*}
  current=$(printf '%s' "${raw#*$'\n'}" | base64 -d)
  updated="$current"
  updated=$(echo "$updated" | jq --arg ts "$(now_iso)" '.updated = $ts')
  while [[ $# -gt 0 ]]; do
    local field="$1" value="$2"; shift 2
    if [[ "$value" == '['* ]]; then
      updated=$(echo "$updated" | jq --argjson v "$value" ".${field} = \$v")
    else
      updated=$(echo "$updated" | jq --arg v "$value" ".${field} = \$v")
    fi
  done
  gh_put_file "$path" "$updated" "$message" "$sha"
}

cmd_init_project() {
  local slug="${1:-}"; shift || true
  [ -z "$slug" ] && { echo "Error: project slug required"; usage; }
  local name="$slug" repos="[]" description="" tags="[]"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --repo) repos=$(echo "$repos" | jq --arg r "$2" '. + [$r]'); shift 2 ;;
      --description) description="$2"; shift 2 ;;
      --tags) tags=$(echo "$2" | tr ',' '\n' | jq -R . | jq -s .); shift 2 ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done
  local now; now=$(now_iso)
  local state
  state=$(jq -n \
    --arg name "$name" --argjson repos "$repos" --arg status "active" \
    --arg description "$description" --argjson tags "$tags" \
    --arg created "$now" --arg updated "$now" \
    '{name:$name, repos:$repos, status:$status, description:$description, tags:$tags, created:$created, updated:$updated}')
  gh_put_file "projects/${slug}/project.json" "$state" "init project: ${slug}"
  echo "Created project: ${slug}"
}

cmd_update_project() {
  local slug="${1:-}"; shift || true
  [ -z "$slug" ] && { echo "Error: project slug required"; usage; }
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) args+=(status "$2"); shift 2 ;;
      --description) args+=(description "$2"); shift 2 ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done
  gh_update_json "projects/${slug}/project.json" "update project: ${slug}" "${args[@]}"
  echo "Updated project: ${slug}"
}

cmd_init_wp() {
  local project="${1:-}" wp="${2:-}"; shift 2 || true
  [ -z "$project" ] || [ -z "$wp" ] && { echo "Error: project and wp slug required"; usage; }
  local name="$wp" description="" priority="medium"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --description) description="$2"; shift 2 ;;
      --priority) priority="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done
  local now; now=$(now_iso)
  local state
  state=$(jq -n \
    --arg name "$name" --arg description "$description" --arg status "planned" \
    --arg priority "$priority" --arg created "$now" --arg updated "$now" \
    '{name:$name, description:$description, status:$status, priority:$priority, created:$created, updated:$updated}')
  gh_put_file "projects/${project}/${wp}/workpackage.json" "$state" "init wp: ${project}/${wp}"
  echo "Created work package: ${project}/${wp}"
}

cmd_update_wp() {
  local project="${1:-}" wp="${2:-}"; shift 2 || true
  [ -z "$project" ] || [ -z "$wp" ] && { echo "Error: project and wp slug required"; usage; }
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) args+=(status "$2"); shift 2 ;;
      --priority) args+=(priority "$2"); shift 2 ;;
      --description) args+=(description "$2"); shift 2 ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done
  gh_update_json "projects/${project}/${wp}/workpackage.json" "update wp: ${project}/${wp}" "${args[@]}"
  echo "Updated work package: ${project}/${wp}"
}

cmd_add_task() {
  local project="${1:-}" wp="${2:-}" task="${3:-}"; shift 3 || true
  [ -z "$project" ] || [ -z "$wp" ] || [ -z "$task" ] && { echo "Error: project, wp, and task slug required"; usage; }
  local name="$task"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done
  local path="projects/${project}/${wp}/tasks/${task}.json"
  local existing
  existing=$(gh_get_sha "$path")
  [ -n "$existing" ] && { echo "Error: task '${task}' already exists in ${project}/${wp}"; exit 1; }
  local now; now=$(now_iso)
  local state
  state=$(jq -n \
    --arg name "$name" --arg status "open" --arg created "$now" --arg updated "$now" \
    '{name:$name, status:$status, commits:[], notes:"", created:$created, updated:$updated}')
  gh_put_file "$path" "$state" "add task: ${project}/${wp}/${task}"
  echo "Created task: ${project}/${wp}/${task}"
}

cmd_update_task() {
  local project="${1:-}" wp="${2:-}" task="${3:-}"; shift 3 || true
  [ -z "$project" ] || [ -z "$wp" ] || [ -z "$task" ] && { echo "Error: project, wp, and task slug required"; usage; }
  local path="projects/${project}/${wp}/tasks/${task}.json"
  local raw current sha
  raw=$(gh_get_sha_and_file "$path")
  [ -z "$raw" ] && { echo "Error: task not found"; exit 1; }
  sha=${raw%%$'\n'*}
  current=$(printf '%s' "${raw#*$'\n'}" | base64 -d)
  local updated="$current"
  updated=$(echo "$updated" | jq --arg ts "$(now_iso)" '.updated = $ts')
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) updated=$(echo "$updated" | jq --arg v "$2" '.status = $v'); shift 2 ;;
      --commit) updated=$(echo "$updated" | jq --arg v "$2" '.commits += [$v]'); shift 2 ;;
      --notes) updated=$(echo "$updated" | jq --arg v "$2" '.notes = $v'); shift 2 ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done
  gh_put_file "$path" "$updated" "update task: ${task}" "$sha"
  echo "Updated task: ${project}/${wp}/${task}"
}

cmd_list() {
  local projects
  projects=$(gh_list_dir projects)
  [ -z "$projects" ] && { echo "No projects tracked."; return; }
  while IFS= read -r slug; do
    [ "$slug" = ".gitkeep" ] && continue
    local state
    state=$(gh_get_file "projects/${slug}/project.json" 2>/dev/null)
    if [ -n "$state" ]; then
      local name status
      name=$(echo "$state" | jq -r '.name')
      status=$(echo "$state" | jq -r '.status')
      printf "  %-25s [%s]\n" "$name" "$status"
    fi
  done <<< "$projects"
}

cmd_show() {
  local slug="${1:-}"
  [ -z "$slug" ] && { echo "Error: project slug required"; usage; }
  local state
  state=$(gh_get_file "projects/${slug}/project.json")
  [ -z "$state" ] && { echo "Error: project '${slug}' not found"; exit 1; }
  echo "=== $(echo "$state" | jq -r '.name') ==="
  echo "$state" | jq '{status, description, repos, tags, updated}'
  local dirs
  dirs=$(gh_list_dir "projects/${slug}")
  while IFS= read -r item; do
    [ "$item" = "project.json" ] && continue
    local wp
    wp=$(gh_get_file "projects/${slug}/${item}/workpackage.json" 2>/dev/null)
    [ -z "$wp" ] && continue
    local wp_name wp_status wp_priority
    wp_name=$(echo "$wp" | jq -r '.name')
    wp_status=$(echo "$wp" | jq -r '.status')
    wp_priority=$(echo "$wp" | jq -r '.priority // ""')
    printf "\n  [%s] %s (%s)\n" "$wp_status" "$wp_name" "$wp_priority"
    local tasks
    tasks=$(gh_list_dir "projects/${slug}/${item}/tasks")
    [ -z "$tasks" ] && continue
    while IFS= read -r tfile; do
      local task
      task=$(gh_get_file "projects/${slug}/${item}/tasks/${tfile}" 2>/dev/null)
      [ -z "$task" ] && continue
      local t_name t_status
      t_name=$(echo "$task" | jq -r '.name')
      t_status=$(echo "$task" | jq -r '.status')
      case "$t_status" in
        done)    printf "    [x] %s\n" "$t_name" ;;
        current) printf "    [>] %s\n" "$t_name" ;;
        dropped) printf "    [-] %s\n" "$t_name" ;;
        *)       printf "    [ ] %s\n" "$t_name" ;;
      esac
    done <<< "$tasks"
  done <<< "$dirs"
}

# Tree sha of projects/ -- changes only when tracked data changes, unlike the
# HEAD commit sha, which also moves for README, script and CI-rebuild commits.
# Like every other read and write here, it follows the default branch.
gh_projects_tree_sha() {
  local out
  out=$(gh api "repos/${TRACKER_REPO}/contents" \
    --jq '.[] | select(.name=="projects") | .sha' 2>/dev/null) || return 0
  printf '%s\n' "$out"
}

open_dashboard() {
  open "$1" 2>/dev/null || xdg-open "$1" 2>/dev/null || echo "Open ${1} in a browser"
}

# Directory holding this script, following symlinks (installs symlink it into
# a bin directory, so $0's dirname is not where the helpers live).
script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="${dir}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}

# Pull the whole repo as one tarball and render it locally. The builder and the
# template come from this install, since a data repo carries only projects/.
# The tarball's copies are a fallback for a bare script whose tracker repo
# still holds the tool.
build_from_tarball() {
  local outfile="$1" tmp status=0
  tmp=$(mktemp -d)
  (
    set -e
    gh api "repos/${TRACKER_REPO}/tarball" > "${tmp}/repo.tar.gz" 2>/dev/null
    mkdir -p "${tmp}/repo"
    tar xzf "${tmp}/repo.tar.gz" -C "${tmp}/repo" --strip-components=1
    here="$(script_dir)"
    builder="${here}/build-dashboard.py"
    [ -f "$builder" ] || builder="${tmp}/repo/scripts/build-dashboard.py"
    [ -f "$builder" ] || { echo "Error: build-dashboard.py not found" >&2; exit 1; }
    template="${here}/../docs/index.html"
    [ -f "$template" ] || template="${tmp}/repo/docs/index.html"
    [ -f "$template" ] || { echo "Error: dashboard template docs/index.html not found" >&2; exit 1; }
    python3 "$builder" "${tmp}/repo/projects" "$template" "$outfile" > /dev/null
  ) || status=1
  rm -rf "$tmp"
  return $status
}

cmd_dashboard() {
  local outfile="dashboard.html" do_open=false force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --open) do_open=true; shift ;;
      --force) force=true; shift ;;
      -*) echo "Unknown option: $1"; usage ;;
      *) outfile="$1"; shift ;;
    esac
  done

  local sha_file="${outfile}.sha"
  local remote_sha key
  remote_sha=$(gh_projects_tree_sha)
  # The installed builder and template are part of the key, so pulling a tool
  # update rebuilds the page even when no tracked data changed.
  key="${remote_sha} $(cat "$(script_dir)/build-dashboard.py" "$(script_dir)/../docs/index.html" 2>/dev/null | cksum || true)"

  if ! $force && [ -f "$outfile" ] && [ -f "$sha_file" ] && [ -n "$remote_sha" ]; then
    if [ "$(cat "$sha_file")" = "$key" ]; then
      echo "Dashboard up to date (no changes since last build)."
      if $do_open; then open_dashboard "$outfile"; fi
      return 0
    fi
  fi

  echo "Fetching project data..."
  build_from_tarball "$outfile" || { echo "Error: could not build dashboard"; exit 1; }

  [ -n "$remote_sha" ] && echo "$key" > "$sha_file"
  echo "Dashboard written to: ${outfile}"
  if $do_open; then open_dashboard "$outfile"; fi
  return 0
}

# Replace the config's repo= line and keep every other line. Written in place
# rather than moved over, so a config file that is a symlink stays one.
write_config_repo() {
  local tmp
  mkdir -p "$(dirname "$CONFIG_FILE")"
  tmp=$(mktemp)
  if [ -f "$CONFIG_FILE" ]; then
    grep -v '^[[:space:]]*repo[[:space:]]*=' "$CONFIG_FILE" > "$tmp" || true
  fi
  printf 'repo=%s\n' "$1" >> "$tmp"
  cat "$tmp" > "$CONFIG_FILE"
  rm -f "$tmp"
}

# Ask before init creates or marks a repo. --yes answers for the user; without
# a terminal nobody can answer, so it declines and says how to go ahead.
confirm() {
  $ASSUME_YES && return 0
  if ! [ -t 0 ]; then
    echo "No terminal to answer on; run again with --yes to go ahead."
    return 1
  fi
  local answer
  printf '%s [Y/n] ' "$1"
  read -r answer || return 1
  case "$answer" in ""|[Yy]|[Yy][Ee][Ss]) return 0 ;; *) return 1 ;; esac
}

# Whether TRACKER_REPO has no commits yet; GitHub answers 409 for an empty repo.
repo_is_empty() {
  local err
  err=$(gh api "repos/${TRACKER_REPO}/commits?per_page=1" --silent 2>&1) && return 1
  [[ "$err" == *"HTTP 409"* ]]
}

# Only ever called on an empty repo. There the Contents API creates the branch
# it is given and makes it the default, so the repo starts on main -- the branch
# the hosted dashboard commits to.
put_marker() {
  local body
  body=$(jq -n --arg c "$(printf '{\n  "schema": 1\n}\n' | base64)" \
    '{message: "Mark as a wAIpoint data repo", content: $c, branch: "main"}')
  gh api "repos/${TRACKER_REPO}/contents/${MARKER_FILE}" --method PUT --input - <<< "$body" > /dev/null
}

cmd_init() {
  local repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [ $# -ge 2 ] || { echo "Error: --repo needs a repo name"; exit 1; }
        repo="$2"; shift 2 ;;
      --yes|-y) ASSUME_YES=true; shift ;;
      *) echo "Unknown option: $1"; usage ;;
    esac
  done

  command -v gh > /dev/null || { echo "Error: gh (GitHub CLI) is not installed. See https://cli.github.com"; exit 1; }
  command -v jq > /dev/null || { echo "Error: jq is not installed."; exit 1; }
  local login
  login=$(gh api user --jq .login 2>/dev/null) \
    || { echo "Error: gh is not logged in, or GitHub is unreachable. Run 'gh auth login' first."; exit 1; }

  # --repo wins, then the repo already configured, then a new default. Not
  # WAIPOINT_REPO: init manages the config file, and the variable is how one
  # shell points somewhere else for a while.
  local configured
  configured=$(config_repo)
  [ -n "$repo" ] || repo="${configured:-${login}/${DEFAULT_DATA_REPO}}"
  [[ "$repo" == */* ]] || repo="${login}/${repo}"
  valid_repo "$repo" || { echo "Error: '${repo}' is not in owner/name form"; exit 1; }
  TRACKER_REPO="$repo"

  local info private="" branch="" can_push="" changed=false
  if info=$(gh api "repos/${repo}" --jq '[.private, .default_branch, .permissions.push] | @tsv' 2>&1); then
    IFS=$'\t' read -r private branch can_push <<< "$info"
    local marker=0
    check_marker || marker=$?
    if [ "$marker" -eq 2 ]; then
      echo "Error: could not check ${repo} for ${MARKER_FILE}."
      echo "$MARKER_ERR"
      exit 1
    elif [ "$marker" -eq 0 ]; then
      echo "${repo} is a wAIpoint data repo."
    elif repo_is_empty; then
      # Nothing in it to mistake for data. This is also how a create whose
      # marker write failed gets finished.
      echo "${repo} exists and is empty."
      confirm "Mark it as your wAIpoint data repo?" || { echo "Nothing was changed."; exit 1; }
      put_marker
      echo "Marked ${repo} as a wAIpoint data repo."
      branch=main changed=true
    else
      echo "Error: ${repo} already exists and has no ${MARKER_FILE} at its root, so it is not a wAIpoint data repo. Nothing was changed."
      echo "Pick another name with --repo. If ${repo} really should hold your wAIpoint data, add ${MARKER_FILE} containing {\"schema\": 1} to its root yourself, then run waipoint init again."
      exit 1
    fi
  elif [[ "$info" == *"HTTP 404"* ]]; then
    echo "${repo} does not exist yet. If you already have a data repo, run: waipoint init --repo <owner>/<name>"
    confirm "Create ${repo} as a private repo?" || { echo "Nothing was created."; exit 1; }
    gh repo create "$repo" --private --description "wAIpoint data repo (https://github.com/jaronimoe/wAIpoint)" > /dev/null
    put_marker || { echo "Error: created ${repo} but could not write ${MARKER_FILE}. Run 'waipoint init --repo ${repo}' again to finish."; exit 1; }
    echo "Created private repo ${repo} and marked it as a wAIpoint data repo."
    private=true branch=main can_push=true changed=true
  else
    echo "Error: could not look up ${repo}."
    echo "$info"
    exit 1
  fi

  if [ "$repo" != "$configured" ]; then
    write_config_repo "$repo"
    if [ -n "$configured" ]; then
      echo "Switched ${CONFIG_FILE} from ${configured} to ${repo}."
    else
      echo "Wrote repo=${repo} to ${CONFIG_FILE}."
    fi
    changed=true
  fi

  [ "$private" = "false" ] && echo "Warning: ${repo} is public, so anyone can read your project data."
  [ "$can_push" = "false" ] && echo "Warning: your gh login cannot write to ${repo}, so updates will fail."
  [ "$branch" = "main" ] || echo "Note: ${repo}'s default branch is ${branch}. The CLI follows it, but the hosted dashboard commits to main."
  if [ -n "${WAIPOINT_REPO:-}" ] && [ "$WAIPOINT_REPO" != "$repo" ]; then
    echo "Note: WAIPOINT_REPO is set to ${WAIPOINT_REPO}, which overrides the config while it is set."
  fi

  if ! $changed; then
    echo "Already set up: ${CONFIG_FILE} points at ${repo}."
    return 0
  fi
  cat <<'EOF'

Next, track a project: in one of your repos, ask your agent to set up wAIpoint
tracking, or run
  waipoint init-project <slug> --repo <owner>/<repo>
For a hosted dashboard, see "Hosting on Cloudflare" in the wAIpoint README.
EOF
}

[ $# -eq 0 ] && usage
command="$1"; shift
case "$command" in
  help|-h|--help) usage ;;
  # init runs before any repo is configured, so it picks its own.
  init) cmd_init "$@"; exit 0 ;;
esac
resolve_tracker_repo
case "$command" in
  init-project)   cmd_init_project "$@" ;;
  update-project) cmd_update_project "$@" ;;
  init-wp)        cmd_init_wp "$@" ;;
  update-wp)      cmd_update_wp "$@" ;;
  add-task)       cmd_add_task "$@" ;;
  update-task)    cmd_update_task "$@" ;;
  list)           cmd_list ;;
  show)           cmd_show "$@" ;;
  dashboard)      cmd_dashboard "$@" ;;
  *)              echo "Unknown command: $command"; usage ;;
esac
